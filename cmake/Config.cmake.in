if(TARGET maeparser::maeparser)
    return()
endif()

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/maeparser-targets.cmake")

check_required_components(maeparser)

set(maeparser_ROOT ${PACKAGE_PREFIX_DIR})

set(MAEPARSER_BUILD_SHARED_LIBS @MAEPARSER_BUILD_SHARED_LIBS@)

# Check for the dependencies
include(CMakeFindDependencyMacro)

find_dependency(Boost @Boost_VERSION_STRING@ COMPONENTS iostreams REQUIRED)

# Check which zlib we used for building
if(@Boost_zlib_FOUND@)
    find_dependency(Boost @Boost_VERSION_STRING@ COMPONENTS zlib REQUIRED)
else()
    find_dependency(ZLIB @ZLIB_VERSION_STRING@ REQUIRED)
endif()

if (NOT maeparser_FIND_QUIETLY)
    message(STATUS "Found a CMake config file for maeparser ${maeparser_VERSION} @ ${maeparser_ROOT}")
endif()
